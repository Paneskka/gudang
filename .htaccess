# URL bersih: /dashboard -> dashboard.php (tanpa ekstensi .php)
# Tidak memakai RewriteBase agar tetap jalan di root domain maupun subfolder.

RewriteEngine On

# 1. Redirect permintaan langsung *.php ke URL bersih (GET/HEAD saja).
#    THE_REQUEST tidak berubah oleh rewrite internal, jadi tidak memicu loop.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s+[^?\s]*\.php(?:\?|\s) [NC]
RewriteCond %{REQUEST_URI} ^(.*)/([A-Za-z0-9_-]+)\.php$
RewriteRule ^ %1/%2 [R=302,L]

# 2. Alias bertanda hubung untuk file berunderscore.
RewriteRule ^antrian-dipanggil$ antrian_dipanggil.php [L]
RewriteRule ^antrian-masuk$ antrian_masuk.php [L]
RewriteRule ^antrian-keluar$ antrian_keluar.php [L]
RewriteRule ^kelola-user$ kelola_user.php [L]

# 3. Tahap internal: /nama -> nama.php bila file yang cocok ada.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([A-Za-z0-9_-]+)$ $1.php [L]
